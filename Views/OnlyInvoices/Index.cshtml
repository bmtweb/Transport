@model PagedList.IPagedList<Transport.Models.Invoice>
@using PagedList.Mvc;
@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<script type="text/javascript">
    $(document).ready(function () {

        $("#ddlcomp").change(function () {
            location.href = "/onlyinvoices/?comp=" + $(this).val();
        });

        $("#btnAdd").click(function () {
            if ($("#ddlcomp").val().trim() == "") {
                alert("Please select company to create invoice!");
                return;
            }
            location.href = "/onlyInvoices/Invoice?comp=" + $("#ddlcomp").val();
        });
        $("#btnFilter").click(function () {
            location.href = "/onlyInvoices/?comp=" + $("#ddlcomp").val() + "&filter=" + $("#ddlFilter").val() + "&value=" + $("#txtFilter").val();
        });
    })
</script>

<div class="main-1">
    <div class="container">
        <ul class="breadcrumb">
            <li><a href="#">Invoice & Billty</a></li>
        </ul>
        @using (Html.BeginForm())
        {
            <div class="btn-group" style="float:left">
                <label class="btn btn-info" style="background-color:ActiveCaption;color:White">Select Company</label>
                @Html.DropDownList("ddlcomp", ((SelectList)ViewBag.Companies),"ALL", new { @class = "btn" })
                <input type="button" id="btnAdd" value="Create New" class="btn btn-info btn-small"/>
            </div>
            <div class="btn-group" style="float:right">
                <label class="btn btn-info">Filter By</label>
                <select id="ddlFilter" class="btn">
                    <option value="Invoice_No">Invoice No</option>
                    <option value="Invoice_Date">Invoice Date</option>
                    <option value="Truck_No">Truck No</option>
                   
                </select>
                <input type="text" id="txtFilter" class="btn" style="border:solid;border-width:1px;text-align:left;" />
                <input type="button" class="btn btn-info " id ="btnFilter" value="Show" />
            </div>
            <div class="row form-horizontal">
                <div class="form-group">
                    <table class="table table-responsive" width="100%">
                        <tr>
                            <th class="grpblock2" >
                                <div class="col-md-12" style="font-size:10px;background-image:url('../../Content/images/tb-one.png');background-repeat:repeat-x;font-size:12px;padding:5px">
                                    <div class="col-md-4">
                                        <div class="col-xs-4">Print@*<img src="@Url.Content("~/Content/images/print.png")"  alt="PRINT" class="btn"/>*@</div>
                                        <div class="col-xs-4">Inv No</div>
                                        <div class="col-xs-3">Date</div>
                                    </div>
                                    <div class="col-md-2">
                                        <div class="col-xs-5">Company</div>
                                    </div>
                                    <div class="col-md-2">
                                        <div class="col-xs-7">Transport</div>
                                    </div>
                                    <div class="col-md-4">
                                        <div class="col-xs-4">Material</div>
                                        <div class="col-xs-3">Weight</div>
                                        <div class="col-xs-4">Truck No</div>
                                        <div class="col-xs-1">
                                         @if (Request.IsAuthenticated)
                                         {
                                             if (@ViewBag.RId == "1")
                                             {   
                                                  @Html.Label("Action")
                                              }
                                         }
                                         </div>
                                    </div>
                                </div>
                            </th>
                        </tr>

                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>
                                    <div class="col-md-12">
                                        <div class="col-md-4">
                                            <div class="col-xs-4">
                                                <a href="#" class="dropdown-toggle btn btn-default btn-sm" data-toggle="dropdown" role="button" aria-expanded="false" title="Select Print Option">Print &nbsp;<span class="caret"></span></a>
                                                <ul class="dropdown-menu" role="menu">
@*                                                    <li><a href="/invoices/print/id=@item.Id&sign=0"  target="_blank" >Print Invoice</a></li>
*@                                                    <li>@Html.ActionLink("Print Invoice ", "Print","invoices", new { id = item.Id, sign = false }, new { @target = "_blank" })</li>
                                                    <li>@Html.ActionLink("Print Invoice With Sign", "Print" ,"invoices", new { id = item.Id, sign = true }, new { @target = "_blank" })</li>
                                                     
                                                </ul>
                                            </div>
                                            <div class="col-xs-3"><span class="badge" style="background-color:Green">@item.Invoice_No</span></div>
                                            <div class="col-xs-3">@item.Invoice_Date.ToString("dd/MMM/yyyy")</div>
                                        </div>
                                        <div class="col-md-2">
                                            <div class="col-xs-10">@item.Company.Name</div>
                                            </div>
                                        <div class="col-md-2">
                                            <div class="col-xs-10">@item.Company2.Name</div>
                                        </div>
                                        <div class="col-md-4">
                                            <div class="col-xs-4">@item.Product.Name</div>
                                            <div class="col-xs-3">@item.Weight</div>
                                            <div class="col-xs-4">@item.Truck_No</div>
                                            <div class="col-xs-1">
                                             @if (Request.IsAuthenticated)
                                             {
                                                 if (@ViewBag.RId == "1")
                                                 {
                                                    <a href="@Url.Action("Invoice", "OnlyInvoices", new { id = item.Id })" title="Click to Edit">
                                                        <img style="border:2px solid #cccccc;border-color:red ;padding:4px"  src="@Url.Content("~/Content/images/edit.png")"  alt="EDIT"/>
                                                    </a>
                                                 }
                                             }
                                             </div>
                                        </div>
                                    </div>
                            </tr>
                        }

                    </table>

                </div>
            </div>
            <div>
                Page  @(Model.PageCount < Model.PageNumber ? 0 : Model.PageNumber) of @Model.PageCount
                @Html.PagedListPager(Model, page => Url.Action("Index", new { page, comp = ViewBag.company_id }))
            </div>
        }
        <br />
        <br />
    </div>
</div>
