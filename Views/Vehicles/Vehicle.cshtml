@model Transport.Models.Vehicle

@{
    ViewBag.Title = "Truck Detail";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<div class="main-1">
    <div class="container">
        @using (Html.BeginForm())
        {
            @Html.ValidationSummary(true)
            <div class="form-horizontal">
                <fieldset>
                    <legend>Vehicle Details</legend>
                    <div class="row form-horizontal">
                        <div class="form-group">
                            <div class="col-xs-12">
                                <div class="col-xs-6">
                                    @Html.LabelFor(model => model.Name, new { @class = "control-label" })
                                </div>
                                <div class="col-xs-6">
                                    @Html.LabelFor(model => model.Owner_Name, new { @class = "control-label" })
                                </div>
                                <div class="col-xs-6">
                                    @Html.TextBoxFor(model => model.Name, new { @minlength = "10",@maxlength = "10", autocomplete = "off", @class = "form-control" })
                                    @Html.ValidationMessageFor(model => model.Name)
                                </div>
                                <div class="col-xs-6">
                                    @Html.TextBoxFor(model => model.Owner_Name, new {@maxlength = "20", @class = "form-control" })
                                    @Html.ValidationMessageFor(model => model.Owner_Name)
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="row form-horizontal">
                        <div class="form-group">
                            <div class="col-xs-12">
                                <div class="col-xs-6">
                                    @Html.LabelFor(model => model.Pan_Card, new { @class = "control-label" })
                                </div>
                                <div class="col-xs-6">
                                    @Html.LabelFor(model => model.TDS_Tax, new { @class = "control-label" })
                                </div>
                                <div class="col-xs-6">
                                    @Html.TextBoxFor(model => model.Pan_Card, new {@Value = "0",@maxlength = "10", @class = "form-control" })
                                    @Html.ValidationMessageFor(model => model.Pan_Card)
                                </div>
                                <div class="col-xs-6">
                                    @Html.TextBoxFor(model => model.TDS_Tax, new { @Value = "0",@maxlength = "4", @class = "form-control" })
                                    @Html.ValidationMessageFor(model => model.TDS_Tax)
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="row form-horizontal">
                        <div class="form-group">
                            <div class="col-xs-12">
                                <div class="col-xs-6">
                                    &nbsp; 
                                </div>
                                <div class="col-xs-6">
                                    @Html.LabelFor(model => model.Status)
                                    @Html.CheckBoxFor(model => model.Status )
                                    @Html.ValidationMessageFor(model => model.Status)
                                </div>
                            </div>
                        </div>
                    </div>
                </fieldset>
            </div>
            <div class="btn-group">
                <input  type="submit" value="@(Model.Id == 0 ? "Save" : "Update")" class="btn btn-info"/>
                @Html.ActionLink("Back", "index", null, new { @class = "btn btn-warning btn-small" })
            </div>
       }
    </div>
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}
