@model IEnumerable<Transport.Models.Invoice>

@{
    ViewBag.Title = "Freight Status Detail";
    Layout = null;
}
<link href="~/Content/bootstrap.css" rel="stylesheet" />
<link href="~/Content/report.css" rel="stylesheet" />
<div class="main-1">
    <div class="container">
        <table class="table-condensed" style="width: 100%;">
                <tr>
                    <td colspan='3' class="tblock" style="text-align:left;font-size:12px">Branch:- @ViewBag.Branch </td>
                    <th colspan='5' class="tblock"><b>Freight Status Detail</b></th>
                    <td colspan='2' class="tblock" >Print Date @DateTime.Now.Date.ToString("dd-MMM-yyyy")</td>
                </tr>
                <tr>
                    <td colspan='10' style="text-align:center;font-size:14px;font-weight:bold">@ViewBag.From_Party</td>
                </tr>
                <tr>
                    <td colspan='10' style="text-align:center;border:1px solid #ccc"><span style="border:1px solid #ccc;padding:5px;border-radius:2px">@ViewBag.From_Date TO @ViewBag.To_Date</span></td>
                </tr>
                @if(@ViewBag.To_Party != "ALL")
                {
                    <tr>
                        <td colspan='10' style="text-align:center;font-weight:600">@ViewBag.To_Party </td>
                    </tr>
                }

            @foreach (var gitem in Model.GroupBy(x => new { x.Transport_Id, Supplier = x.Company1.Name }))
            {
                <tr>
                    <th  colspan="10" class="grpblock2">@gitem.Key.Supplier</th>
                </tr>
                <tr>
                    <th>S.NO</th>
                    <th>Bilty No</th>
                    <th>Date</th>
                    <th>Party</th>
                    <th>Truck No</th>
                    <th>Weight</th>
                    <th>CD1</th>
                    <th>CD2</th>
                    <th>Amount</th>
                    <th>Remark</th>
                </tr>
                int I = 1;
                foreach (var item in Model.Where(x => x.Transport_Id == gitem.Key.Transport_Id).ToArray())
                {
                <tr>
                    <td>@(I++)</td>
                    <td>@item.Billty_No</td>
                    <td>@item.Invoice_Date.ToString("dd-MMM-yyyy")</td>
                    <td>@item.Company.Name</td>
                    <td>@item.Truck_No</td>
                    <td>@item.Weight</td>
                    <td>@item.Code_1</td>
                    <td>@item.Code_2</td>

                    @if (item.BillType == "To Pay")
                    {
                        <td>@String.Format(new System.Globalization.CultureInfo("en-IN"), "{0:#,##}", Math.Round(Convert.ToDouble((item.Weight - (decimal)0.3) * (item.Code_2 - 2) * 10), 0))</td>
                    }
                    else
                    {
                        <td>@String.Format(new System.Globalization.CultureInfo("en-IN"), "{0:#,##}",  Math.Round(Convert.ToDouble((item.Weight - (decimal)0.3) * (item.Code_2) * 10), 0))</td>
                    }
                    <td></td>
                </tr>
                }
            
                <tr>
                    <th colspan='5' style="text-align: right">Total :</th>
                    <th>@Model.Where(x => x.Transport_Id == gitem.Key.Transport_Id).Sum(x => x.Weight)</th>
                    <th colspan='2'></th>
                    <th>@String.Format(new System.Globalization.CultureInfo("en-IN"), "{0:C}", Model.Where(x => x.Transport_Id == gitem.Key.Transport_Id).Sum(item => item.BillType == "To Pay" ? ((item.Weight - (decimal)0.3) * (item.Code_2 - 2) * 10)  : ((item.Weight - (decimal)0.3) * (item.Code_2) * 10)), 0))</th>
                    <th></th>
                </tr>
                <tr>
                <td colspan='10'></td>
            </tr>
            }
        </table>
    </div>
</div>
