@model IEnumerable<Transport.Models.Invoice>

@{
    ViewBag.Title = "Sales Turnover Detail";
    Layout = null;
}
<link href="~/Content/report.css" rel="stylesheet" />
<link href="~/Content/bootstrap.css" rel="stylesheet" />
<div class="main-1">
    <div class="container">
        <table class="table-condensed" width="100%">
            @{
                double gstTax=0.0;
                double igstTax = 0.0;
                
                if (@ViewBag.RateApplied == "0")
                {
                        <tr>
                            <td colspan='3' class="tblock" style="text-align:left;font-size:12px">Branch:- @ViewBag.Branch </td>
                            <th colspan='6' class="tblock"><b>Sales Turnover Detail</b></th>
                            <td colspan='3' class="tblock" >Print Date @DateTime.Now.Date.ToString("dd-MMM-yyyy")</td>
                        </tr>
                        <tr>
                            <td colspan='12' style="text-align:center;font-size:14px;font-weight:bold">@ViewBag.From_Party</td>
                        </tr>
                        <tr>
                            <td colspan='12' style="text-align:center;"><span style="border:1px solid #ccc;padding:5px;border-radius:2px">@ViewBag.From_Date TO @ViewBag.To_Date</span></td>
                        </tr>
                    if (@ViewBag.To_Party != "ALL")
                    {
                            <tr>
                                <td colspan='12' style="text-align:center;font-weight:600">@ViewBag.To_Party </td>
                            </tr>
                    }
                }
                else if (@ViewBag.RateApplied == "1")
                {
                        <tr>
                            <td colspan='2' class="tblock" style="text-align:left;font-size:12px">Branch:- @ViewBag.Branch </td>
                            <th colspan='6' class="tblock"><b>Sales Turnover Detail</b></th>
                            <td colspan='2' class="tblock" >Print Date @DateTime.Now.Date.ToString("dd-MMM-yyyy")</td>
                        </tr>
                        <tr>
                            <td colspan='10' style="text-align:center;font-size:14px;font-weight:bold">@ViewBag.From_Party</td>
                        </tr>
                        <tr>
                            <td colspan='10' style="text-align:center;"><span style="border:1px solid #ccc;padding:5px;border-radius:2px">Date :@ViewBag.From_Date - @ViewBag.To_Date</span></td>
                        </tr>
               
                    if (@ViewBag.To_Party != "ALL")
                    {
                            <tr>
                                <td colspan='10' style="text-align:center;font-weight:600">@ViewBag.To_Party </td>
                            </tr>
                    }
                }
                else if (@ViewBag.RateApplied == "2")
                {
                        <tr>
                            <td colspan='2' class="tblock" style="text-align:left;font-size:12px">Branch:- @ViewBag.Branch </td>
                            <th colspan='5' class="tblock"><b>Sales Turnover Detail</b></th>
                            <td colspan='2' class="tblock" >Print Date @DateTime.Now.Date.ToString("dd-MMM-yyyy")</td>
                        </tr>
                        <tr>
                            <td colspan='9' style="text-align:center;font-size:14px;font-weight:bold">@ViewBag.From_Party</td>
                        </tr>
                        <tr>
                            <td colspan='9' style="text-align:center;"><span style="border:1px solid #ccc;padding:5px;border-radius:2px">Date :@ViewBag.From_Date - @ViewBag.To_Date</span></td>
                        </tr>
                
                    if (@ViewBag.To_Party != "ALL")
                    {
                            <tr>
                                <td colspan='9' style="text-align:center;font-weight:600">@ViewBag.To_Party </td>
                            </tr>
                    }
                }


                if (@ViewBag.RateApplied == "0")
                {    
                    <tr>
                        <th>SNo </th>
                        <th style="width:80px">Date </th>
                        <th>Recipient </th>
                        <th>Inv No </th>
                        <th style="width:170px">Material </th>
                        <th>Wgt(M.T.)</th>
                        <th>Inv Rate </th>
                        <th>Inv Amt</th>
                        <th>CGST </th>
                        <th>SGST</th>
                        <th>IGST </th>
                        <th>Grand Total</th>
                    </tr>
                }
                else if (@ViewBag.RateApplied == "1")
                {
                    <tr>
                        <th>SNo </th>
                        <th>Date </th>
                        <th>Recipient </th>
                        <th>Inv No </th>
                        <th>Material </th>
                        <th>Wgt(M.T.)</th>
                        <th>Inv Rate </th>
                        <th>Inv Amt</th>
                        <th>Vat Amt</th>
                        <th>Total</th>
                    </tr>
                }
                else if (@ViewBag.RateApplied == "2")
                {
                    <tr>
                        <th>SNo </th>
                        <th>Date </th>
                        <th>Recipient </th>
                        <th>Inv No </th>
                        <th>Material </th>
                        <th>Wgt(M.T.)</th>
                        <th>Cash Rate </th>
                        <th>Cash Amt </th>
                    </tr>
                }


                foreach (var gitem in Model.GroupBy(x => new { x.Supplier_Id, Supplier = x.Company2.Name }).Select(x => new { x.Key.Supplier_Id, supName = x.Key.Supplier, cRate = x.Sum(y => y.C_Rate) }))
                {
                    if (@ViewBag.RateApplied == "0")
                    {    
                    <tr>
                        <th colspan="12" class="grpblock2">@gitem.supName</th>
                    </tr>
                    }
                    else if (@ViewBag.RateApplied == "1")
                    {
                    <tr>
                        <th colspan="10" class="grpblock">@gitem.supName</th>
                    </tr>
                    }
                    else if (@ViewBag.RateApplied == "2")
                    {
                        if (@gitem.cRate != 0)
                        {
                            <tr>
                                <th colspan="8" class="grpblock">@gitem.supName</th>
                            </tr>
                        }
                    }

                    int I = 1;
                    foreach (var item in Model.Where(x => x.Supplier_Id == gitem.Supplier_Id).ToArray())
                    {
                        if (@ViewBag.RateApplied == "0")
                        {
                         <tr>
                            <td>@(I++)</td>
                            <td>@item.Invoice_Date.ToString("dd-MMM-yyyy")</td>
                            <td>@item.Company.Name</td>
                            <td>@item.Invoice_No</td>
                            <td>@item.Product.Name</td>
                            <td style="text-align: right">@item.Weight</td>
                            <td style="text-align: right">@item.B_Rate</td>
                            <td style="text-align: right">@String.Format(new System.Globalization.CultureInfo("en-IN"), "{0:#,##}", item.Invoice_Amount)</td>

                            @{
                                
                            if (item.Company.State.ToUpper() == "RAJASTHAN")
                            {
                                gstTax = gstTax  + (double)item.VAT_Amount;
                                <td style="text-align: right">@Math.Round((double)item.VAT_Amount,2) </td>                                    
                                <td style="text-align: right">@Math.Round((double)item.VAT_Amount, 2) </td>                                    
                                <td style="text-align: right">0 </td>                                    
                                <td style="text-align: right">@String.Format(new System.Globalization.CultureInfo("en-IN"), "{0:#,##}", Math.Round((((item.Invoice_Amount ?? 0) + (item.VAT_Amount ?? 0) + (item.VAT_Amount ?? 0))), 2))</td>
                            }
                            else
                            {
                                igstTax = igstTax  + (double)item.VAT_Amount;
                                <td style="text-align: right">0 </td>                                    
                                <td style="text-align: right">0</td>                                    
                                <td style="text-align: right">@Math.Round((double)item.VAT_Amount, 2) </td>                                    
                                <td style="text-align: right">@String.Format(new System.Globalization.CultureInfo("en-IN"), "{0:#,##}", Math.Round((((item.Invoice_Amount ?? 0) + (item.VAT_Amount ?? 0) + (item.VAT_Amount ?? 0))), 2))</td>                            
                            }
                            }

@*                          <td style="text-align: right">@String.Format(new System.Globalization.CultureInfo("en-IN"), "{0:#,##}", (item.Invoice_Amount + item.VAT_Amount))</td>
                            <td style="text-align: right">@String.Format(new System.Globalization.CultureInfo("en-IN"), "{0:N}", Math.Round(((item.C_Rate ??0) * item.Weight), 0))</td>
                            <td style="text-align: right">@String.Format(new System.Globalization.CultureInfo("en-IN"), "{0:#,##}", Math.Round((((item.Invoice_Amount ??0) + ( item.VAT_Amount  ??0)  ) ), 2))</td>
*@                        </tr>
                        }
                        else if (@ViewBag.RateApplied == "1")
                        {
                         <tr>
                            <td>@(I++)</td>
                            <td>@item.Invoice_Date.ToString("dd-MMM-yyyy")</td>
                            <td>@item.Company.Name</td>
                            <td>@item.Invoice_No</td>
                            <td>@item.Product.Name</td>
                            <td style="text-align: right">@item.Weight</td>
                            <td style="text-align: right">@item.B_Rate</td>
                            <td style="text-align: right">@String.Format(new System.Globalization.CultureInfo("en-IN"), "{0:#,##}", item.Invoice_Amount)</td>
                            <td style="text-align: right">@String.Format(new System.Globalization.CultureInfo("en-IN"), "{0:#,##}", item.VAT_Amount)</td>
                            <td style="text-align: right">@String.Format(new System.Globalization.CultureInfo("en-IN"), "{0:#,##}", ((item.Invoice_Amount ?? 0) + (item.VAT_Amount ?? 0)))</td>
                        </tr>
                        }
                        else if (@ViewBag.RateApplied == "2")
                        {
                            if (@item.C_Rate != 0)
                            {
                                <tr>
                                    <td>@(I++)</td>
                                    <td>@item.Invoice_Date.ToString("dd-MMM-yyyy")</td>
                                    <td>@item.Company.Name</td>
                                    <td>@item.Invoice_No</td>
                                    <td>@item.Product.Name</td>
                                    <td style="text-align: right">@item.Weight</td>
                                    <td style="text-align: right">@item.C_Rate</td>
                                    <td style="text-align: right">@String.Format(new System.Globalization.CultureInfo("en-IN"), "{0:#,##}", Math.Round(((item.C_Rate ?? 0) * item.Weight), 0))</td>
                                </tr>
                            }
                        }
                    }


                    if (@ViewBag.RateApplied == "0")
                    {
                    <tr>
                        <th colspan='5' style="text-align: right">Total &nbsp;</th>
                        <th style="text-align: right">@Model.Where(x => x.Supplier_Id == gitem.Supplier_Id).Sum(x => x.Weight)</th>
                        <th style="text-align: right">&nbsp;</th>
                        <th style="text-align: right">@String.Format(new System.Globalization.CultureInfo("en-IN"), "{0:#,##}", Model.Where(x => x.Supplier_Id == gitem.Supplier_Id).Sum(x => x.Invoice_Amount))</th>
@*                      <th style="text-align: right">@String.Format(new System.Globalization.CultureInfo("en-IN"), "{0:#,##}", Model.Where(x => x.Supplier_Id == gitem.Supplier_Id).Sum(x => x.VAT_Amount))</th>
                        <th style="text-align: right">@String.Format(new System.Globalization.CultureInfo("en-IN"), "{0:#,##}", Model.Where(x => x.Supplier_Id == gitem.Supplier_Id).Sum(x => (x.VAT_Amount + x.Invoice_Amount)))</th>
                        <th style="text-align: right">@String.Format(new System.Globalization.CultureInfo("en-IN"), "{0:#,##}", Math.Round(Model.Where(x => x.Supplier_Id == gitem.Supplier_Id).Sum(x => (x.Weight * x.C_Rate ?? 0)), 0))</th>
*@                      
                        <th style="text-align: right">@String.Format(new System.Globalization.CultureInfo("en-IN"), "{0:#,##}",  gstTax )</th>
                        <th style="text-align: right">@String.Format(new System.Globalization.CultureInfo("en-IN"), "{0:#,##}",  gstTax )</th>
                        <th style="text-align: right">@String.Format(new System.Globalization.CultureInfo("en-IN"), "{0:#,##}", igstTax )</th>
@*                        <th style="text-align: right">@String.Format(new System.Globalization.CultureInfo("en-IN"), "{0:#,##}", Math.Round((Model.Where(x => x.Supplier_Id == gitem.Supplier_Id).Sum(x => (x.Weight * (x.C_Rate ?? 0))) + Model.Where(x => x.Supplier_Id == gitem.Supplier_Id).Sum(x => ((x.VAT_Amount ?? 0) + (x.Invoice_Amount ?? 0)))), 0))</th>*@
                        <th style="text-align: right">@String.Format(new System.Globalization.CultureInfo("en-IN"), "{0:#,##}", Math.Round((Model.Where(x => x.Supplier_Id == gitem.Supplier_Id).Sum(x => (x.Weight * (x.C_Rate ?? 0))) + Model.Where(x => x.Supplier_Id == gitem.Supplier_Id).Sum(x => ((x.VAT_Amount ?? 0) + (x.Invoice_Amount ?? 0)))), 0))</th>

                    </tr>                    
                    <tr>
                        <td colspan="12" class="tblank"></td>
                    </tr>
                    }
                    else if (@ViewBag.RateApplied == "1")
                    {
                    <tr>
                        <th colspan='5' style="text-align: right">Total &nbsp;</th>
                        <th style="text-align: right">@Model.Where(x => x.Supplier_Id == gitem.Supplier_Id).Sum(x => x.Weight)</th>
                        <th style="text-align: right">&nbsp;</th>
                        <th style="text-align: right">@String.Format(new System.Globalization.CultureInfo("en-IN"), "{0:#,##}", Model.Where(x => x.Supplier_Id == gitem.Supplier_Id).Sum(x => x.Invoice_Amount ?? 0))</th>
                        <th style="text-align: right">@String.Format(new System.Globalization.CultureInfo("en-IN"), "{0:#,##}", Model.Where(x => x.Supplier_Id == gitem.Supplier_Id).Sum(x => x.VAT_Amount ?? 0))</th>
                        <th style="text-align: right">@String.Format(new System.Globalization.CultureInfo("en-IN"), "{0:#,##}", Model.Where(x => x.Supplier_Id == gitem.Supplier_Id).Sum(x => ((x.VAT_Amount ?? 0) + (x.Invoice_Amount ?? 0))))</th>
                    </tr>
                    <tr>
                        <td colspan="10" class="tblank"></td>
                    </tr>
                    }
                    else if (@ViewBag.RateApplied == "2")
                    {
                        if (gitem.cRate != 0)
                        {
                            <tr>
                                <th colspan='5' style="text-align: right">Total &nbsp;</th>
                                <th style="text-align: right">@Model.Where(x => x.Supplier_Id == gitem.Supplier_Id).Sum(x => x.Weight)</th>
                                <th style="text-align: right">&nbsp;</th>
                                <th style="text-align: right"> @String.Format(new System.Globalization.CultureInfo("en-IN"), "{0:#,##}", Math.Round(Model.Where(x => x.Supplier_Id == gitem.Supplier_Id).Sum(x => (x.Weight * (x.C_Rate ?? 0))), 0))</th>
                            </tr>                    
                            <tr>
                                <td colspan="8" class="tblank"></td>
                            </tr>
                        }
                    }
                }
         }
        </table>
    </div>
</div>
