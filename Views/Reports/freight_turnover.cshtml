@model IEnumerable<Transport.Models.Invoice>

@{
    ViewBag.Title = "Freight Turnover Detail";
    Layout = null;
}
<link type="text/css" href="~/Content/bootstrap.css" rel="stylesheet" />
<link type="text/css" href="~/Content/report.css" rel="stylesheet" />
<div class="main-1">
    <div class="container">
        <table class="table-condensed" style="width:100%;">
                <tr>
                    <td colspan='3' class="tblock" style="text-align:left;font-size:12px">Branch:- @ViewBag.Branch </td>
                    <th colspan='4' class="tblock"><b>Freight Turnover Detail ( @Request["Bilty"].ToUpper() )</b></th>
                    <td colspan='3' class="tblock" >Print Date @DateTime.Now.Date.ToString("dd-MMM-yyyy")</td>
                </tr>
                <tr>
                    <td colspan='10' style="text-align:center;font-size:14px;font-weight:bold">@ViewBag.From_Party</td>
                </tr>
                <tr>
                    <td colspan='10' style="text-align:center;border:1px solid #ccc"><span style="border:1px solid #ccc;padding:5px;border-radius:2px">@ViewBag.From_Date TO @ViewBag.To_Date</span></td>
                </tr>
                @if(@ViewBag.To_Party != "ALL")
                {
                    <tr>
                        <td colspan='10' style="text-align:center;font-weight:600">@ViewBag.To_Party </td>
                    </tr>
                }
            @foreach (var gitem in Model.GroupBy(x => new { x.Transport_Id, Transporter = x.Company1.Name}))
            {
                <tr>
                    <th colspan="10" class="grpblock">@gitem.Key.Transporter</th>
                </tr>
                <tr>
                    <th>S.NO</th>
                    <th>Bilty No</th>
                    <th>Date</th>
                    <th>From</th>
                    <th>To</th>
                    <th>Material</th>
                    <th>Truck No</th>
                    <th>Weight</th>
                    <th>Rate</th>
                    <th>Freight</th>
                </tr>

            
                int I = 1;
                foreach (var item in Model.Where(x => x.Transport_Id == gitem.Key.Transport_Id).ToArray())
                {
                <tr>
                    <td>@(I++)</td>
                    <td>@item.Billty_No</td>
                    <td>@item.Invoice_Date.ToString("dd-MMM-yyyy")</td>
                    <td>@item.Company2.Name</td>
                    <td>@item.Company.Name</td>

                    <td>@item.Product.Name</td>
                    <td>@item.Truck_No</td>
                    <td>@item.Weight</td>
                    <td>@item.Freight_Rate</td>
                    <td>@String.Format(new System.Globalization.CultureInfo("en-IN"), "{0:#,##}",@item.Freight)</td>
                </tr>
                }
            
                <tr>
                    <th colspan='7' style="text-align: right">Total :</th>
                    <th>@Model.Where(x => x.Transport_Id == gitem.Key.Transport_Id).Sum(x => x.Weight)</th>
                    <th></th>
                    <th>@String.Format(new System.Globalization.CultureInfo("en-IN"), "{0:#,##}",@Model.Where(x => x.Transport_Id == gitem.Key.Transport_Id).Sum(x => x.Freight))</th>
                </tr>
            }
        </table>
    </div>
</div>
