@model IEnumerable<Transport.Models.Invoice>

@{
    ViewBag.Title = "Total Freight Summary";
    Layout = null;
}
<link href="~/Content/report.css" rel="stylesheet" />
<link href="~/Content/bootstrap.css" rel="stylesheet" />
<div class="main-1">
    <div class="container">

        <table class="table-condensed" style="width: 100%;">
                <tr>
                    <td  class="tblock" style="text-align:left;font-size:12px">Branch:- @ViewBag.Branch </td>
                    <th  class="tblock"><b>Total Freight Summary</b></th>
                    <td colspan='2' class="tblock" >Print Date @DateTime.Now.Date.ToString("dd-MMM-yyyy")</td>
                </tr>
                <tr>
                    <td colspan='4' style="text-align:center;font-size:14px;font-weight:bold">@ViewBag.From_Party</td>
                </tr>
                <tr>
                    <td colspan='4' style="text-align:center;border:1px solid #ccc"><span style="border:1px solid #ccc;padding:5px;border-radius:2px">@ViewBag.From_Date TO @ViewBag.To_Date</span></td>
                </tr>
                @if(@ViewBag.To_Party != "ALL")
                {
                    <tr>
                        <td colspan='4' style="text-align:center;font-weight:600">@ViewBag.To_Party </td>
                    </tr>
                }
                <tr>
                    <th style="text-align:center">To Party </th>
                    <th style="text-align:center">Total Weight </th>
                    <th style="text-align:center">No of Truck </th>
                    <th style="text-align:center">Total Frg Amt</th>
                </tr>
            @foreach (var gitem in Model.GroupBy(x => new { x.Transport_Id, Transporter = x.Company1.Name }))
            {
                <tr>
                    <th colspan="4" class="grpblock2">@gitem.Key.Transporter</th>
                </tr>
            
                if (Request["group"] == "transrec")
                {
                    {
                        foreach (var pitem in Model.Where(x => x.Transport_Id == gitem.Key.Transport_Id).GroupBy(x => new { x.Company_Id, x.Company.Name }).Select(x => new { Name = x.Key.Name, x.Key.Company_Id }).ToArray())
                        {
                            <tr>
                                <th colspan="3" class="grpblock2">@pitem.Name</th>
                            </tr>
                            foreach (var item in Model.Where(x => x.Transport_Id == gitem.Key.Transport_Id && x.Company_Id == pitem.Company_Id).GroupBy(x => new { x.Product_Id, x.Product.Name }).Select(x => new { x.Key.Name, Weight = x.Sum(y => y.Weight), totTruck = x.Count(), totFrg = x.Sum(y => Math.Round(Convert.ToDouble(y.Weight * y.Freight_Rate), 0)) }))
                            {
                                <tr>
                                    <td>@item.Name</td>
                                    <td style="text-align:right">@item.Weight</td>
                                    <td style="text-align:center">@item.totTruck</td>
                                    <td style="text-align:right">@String.Format(new System.Globalization.CultureInfo("en-IN"), "{0:#,##}",@item.totFrg)</td>
                                </tr>
                            }

                        }

                    }
                }
                else if (Request["group"] == "transmat")
                {
                    {
                        foreach (var pitem in Model.Where(x => x.Transport_Id == gitem.Key.Transport_Id).GroupBy(x => new { x.Product_Id, x.Product.Name }).Select(x => new { Name = x.Key.Name, x.Key.Product_Id }).ToArray())
                        {
                            <tr>
                                <th colspan="3">@pitem.Name</th>
                            </tr>
                            foreach (var item in Model.Where(x => x.Transport_Id == gitem.Key.Transport_Id && x.Product_Id == pitem.Product_Id).GroupBy(x => new { x.Company_Id, x.Company.Name }).Select(x => new { x.Key.Name, Weight = x.Sum(y => y.Weight), totTruck = x.Count(), totFrg = x.Sum(y => Math.Round(Convert.ToDouble(y.Weight * y.Freight_Rate), 0)) }))
                            {
                                <tr>
                                    <td>@item.Name</td>
                                    <td style="text-align:right">@item.Weight</td>
                                    <td style="text-align:center">@item.totTruck</td>
                                    <td style="text-align:right">@String.Format(new System.Globalization.CultureInfo("en-IN"), "{0:#,##}",@item.totFrg)</td>
                                </tr>
                            }

                        }

                    }
                }
                else if (Request["group"] == "none")
                {
                    {
                        foreach (var pitem in Model.Where(x => x.Transport_Id == gitem.Key.Transport_Id).GroupBy(x => new { x.Company_Id, x.Company.Name }).Select(x => new { Name = x.Key.Name, Weight = x.Sum(y => y.Weight), totTruck = x.Count(), totFrg = x.Sum(y => Math.Round(Convert.ToDouble(y.Weight * y.Freight_Rate), 0)) }).ToArray())
                        {
                        <tr>
                            <td>@pitem.Name</td>
                            <td style="text-align:right">@pitem.Weight</td>
                            <td style="text-align:center">@pitem.totTruck</td>
                            <td style="text-align:right">@String.Format(new System.Globalization.CultureInfo("en-IN"), "{0:#,##}",@pitem.totFrg)</td>
                        </tr>
                        }

                    }
                }
                <tr>
                    <th class="grpblock2" >Grand Total</th>
                    <th style="text-align:right">@Model.Where(x => x.Transport_Id == gitem.Key.Transport_Id).Sum(x => x.Weight)</th>
                    <th style="text-align:center">@Model.Where(x => x.Transport_Id == gitem.Key.Transport_Id).Count()</th>
                    <th style="text-align:right">@String.Format(new System.Globalization.CultureInfo("en-IN"), "{0:C}", @Model.Where(x => x.Transport_Id == gitem.Key.Transport_Id).Sum(x => Math.Round(Convert.ToDouble(x.Weight * x.Freight_Rate), 0)))</th>
                </tr>
            }
        </table>


    </div>
</div>
