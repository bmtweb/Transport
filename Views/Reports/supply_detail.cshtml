@model IEnumerable<Transport.Models.Invoice>

@{
    ViewBag.Title = "Supply Transaction Detail";
    Layout = null;
}
<link href="~/Content/bootstrap.css" rel="stylesheet" />
<link href="~/Content/report.css" rel="stylesheet" />
<div class="main-1">
    <div class="container">
        <table class="table-condensed" width="100%">
