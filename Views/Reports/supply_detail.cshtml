                    <th >Material</th>
                    <th >Type</th>
                    <th >Truck No</th>
                    <th>Weight</th>
                    <th>CD1</th>
                    <th>CD2</th>
                    <th>ADV(Rs)</th>
                    <th>Mark</th>
                </tr>
