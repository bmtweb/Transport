@model IEnumerable<Transport.Models.Invoice>

@{
    ViewBag.Title = "Freight paidover Detail";
    Layout = null;
}
<link href="~/Content/bootstrap.css" rel="stylesheet" />
<link href="~/Content/report.css" rel="stylesheet" />
<div class="main-1">
    <div class="container">
        <table class="table-condensed" style="width:100%;">
                <tr>
                    <td colspan='3' class="tblock" style="text-align:left;font-size:12px">Branch:- @ViewBag.Branch </td>
                    <th colspan='2' class="tblock"><b>Freight paidover Detail</b></th>
                    <td colspan='3' class="tblock" >Print Date @DateTime.Now.Date.ToString("dd-MMM-yyyy")</td>
                </tr>
                <tr>
                    <td colspan='8' style="text-align:center;font-size:14px;font-weight:bold">@ViewBag.From_Party</td>
                </tr>
                <tr>
                    <td colspan='8' style="text-align:center;border:1px solid #ccc"><span style="border:1px solid #ccc;padding:5px;border-radius:2px">@ViewBag.From_Date TO @ViewBag.To_Date</span></td>
                </tr>
                @if(@ViewBag.To_Party != "ALL")
                {
                    <tr>
                        <td colspan='8' style="text-align:center;font-weight:600">@ViewBag.To_Party </td>
                    </tr>
                }
            @foreach (var gitem in Model.GroupBy(x => new { x.Transport_Id, Supplier = x.Company1.Name }))
            {
                <tr>
                    <th  colspan="8" class="grpblock">@gitem.Key.Supplier</th>
                </tr>
                <tr>
                    <th style="text-align:center">S.NO</th>
                    <th style="text-align:center">Bilty No</th>
                    <th style="text-align:center">Date</th>
                    <th style="width:200px">Party</th>
                    <th style="text-align:center">Truck No</th>
                    <th style="text-align:center">Weight</th>
                    <th style="text-align:center">Rate</th>
                    <th style="text-align:center">Amount</th>
                </tr>
                int I = 1;
                foreach (var item in Model.Where(x => x.Transport_Id == gitem.Key.Transport_Id).ToArray())
                {
                <tr>
                    <td>@(I++)</td>
                    <td>@item.Billty_No</td>
                    <td>@item.Invoice_Date.ToString("dd-MMM-yyyy")</td>
                    <td style="width:200px">@item.Company.Name</td>
                    <td>@item.Truck_No</td>
                    <td>@item.Weight</td>
                    <td>@item.Code_1</td>
                    @if (item.BillType == "To Pay")
                    {
                        <td style="text-align:right">@String.Format(new System.Globalization.CultureInfo("en-IN"), "{0:#,##}", Math.Round(Convert.ToDouble(item.Weight * (item.Code_1 - 2) * 10), 0))</td>
                    }
                    else
                    {
                        <td style="text-align:right">@String.Format(new System.Globalization.CultureInfo("en-IN"), "{0:#,##}", Math.Round(Convert.ToDouble(item.Weight * (item.Code_1) * 10), 0))</td>
                    }
                </tr>
                } 
                <tr>
                    <th colspan='5' style="text-align: right">Total :</th>
                    <th>@Model.Where(x => x.Transport_Id == gitem.Key.Transport_Id).Sum(x => Math.Round(x.Weight,3))</th>
                    <th class="tblank"></th>
                    <th style="text-align:right">@String.Format(new System.Globalization.CultureInfo("en-IN"), "{0:#,##}", Model.Where(x => x.Transport_Id == gitem.Key.Transport_Id).Sum(item => item.BillType == "To Pay" ? Math.Round(Convert.ToDouble(item.Weight * (item.Code_1 - 2) * 10), 0) : Math.Round(Convert.ToDouble(item.Weight * (item.Code_1) * 10), 0)))</th>
                </tr>
                <tr>
            </tr>
            }
        </table>
    </div>
</div>
