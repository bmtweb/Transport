@model Transport.Models.Account_Report
@{
    ViewBag.Title = "Tranport Accounts";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<script type="text/javascript">

    function check() {
        var dropdown = document.getElementById("ReportType1");
        var current_value = dropdown.options[dropdown.selectedIndex].value;
        var selection = document.getElementById("toParty");
        if (current_value == "302") {
            document.getElementById("LastDate").style.display = "none";
            document.getElementById("partyTo").style.display = "none";
            document.getElementById("lbl22").innerHTML = "On Dated";
            selection.selectedIndex = "0";
        }
        else {
            document.getElementById("LastDate").style.display = "block";
            document.getElementById("partyTo").style.display = "block";
            document.getElementById("lbl22").innerHTML = "From Date";
        }
    }
</script>

<script type="text/javascript">
    $(document).ready(function () {
        $(".Date").datepicker({
            minDate: '@(Convert.ToDateTime(Request.Cookies["FY"].Value.Split('-')[0]).ToString("dd/MMM/yyyy"))',
            dateFormat: 'dd/M/yy',
            maxDate: '@(Convert.ToDateTime(Request.Cookies["FY"].Value.Split('-')[1]).ToString("dd/MMM/yyyy"))'
        });

        $(".Branch").change(function () {
            location.href = "/Reports/tranports_accounts?Branch_Id=" + $(this).val();
        });

        HideShow();

        $('.ReportType').change(function () {
            HideShow();
        });


        function HideShow() {

            if (parseInt($('.ReportType').val()) == 29) 
            {
                $('.grpBy').show();
            } else 
            {
                $('.grpBy').hide();               
            }

            if (parseInt($('.ReportType').val()) == 22 || parseInt($('.ReportType').val()) == 27) {
                $('.Turnover').show();
            } else {
                $('.Turnover').hide();
            }

            if (parseInt($('.ReportType').val()) == 27) {

                $('.orderBy').show();
                $('.paidBy').show();
                $('.second').show();                
            } else {
                $('.orderBy').hide();
                $('.paidBy').hide();
                $('.second').hide();
            }

        }
    });
</script>
