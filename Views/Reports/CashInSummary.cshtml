@model IEnumerable<Transport.Models.Transaction>
@{
    ViewBag.Title = "Cagh Balance Summary";
}
<link type="text/css" href="~/Content/report.css" rel="stylesheet" />
<link type="text/css" href="~/Content/bootstrap.css" rel="stylesheet" />

<div class="main-1">
    <div class="container">
        <table class="table-condensed" style="width:100%">
              <thead style="border:0px solid">
                <tr>
                    <th colspan='3' class="grpblock" style="font-size:20px"><b>Cash Payment Summary</b></th>
                </tr>
                <tr>
                    <td colspan='3' class="grpblock" style="text-align:center;height:50px"><span style="padding:5px;">@ViewBag.From_Date -  @ViewBag.To_Date</span></td>
                </tr>
            </thead>
                <tr>
                    <th style="text-align:center">S No</th>
                    <th style="text-align:center"><b>Receipent</b></th>
                    <th style="text-align:center">Total Cash Received (Rs)</th>
                </tr>

                @{
                      int I = 0;
                      foreach (var gitem in Model.GroupBy(x => new { x.Cr_Account_Id, Supplier = x.Company.Name }))
                      {
                        <tr>
                            <td colspan='3' class="grpblock2">@gitem.Key.Supplier  </td>
                        </tr>
                        I=1;
                          foreach (var ritem in gitem.Where(x => x.Cr_Account_Id == gitem.Key.Cr_Account_Id && x.Particular =="Reciept").GroupBy(x => new { x.Dr_Account_Id, x.Company1.Name }).Select(x => new { Name = x.Key.Name, CashBal = x.Sum(t => t.Amount1 ), Count = x.Count() }).ToArray())
                          {
                            <tr>
                                <td style="text-align:center;font-weight:600">@(I++)</td>
                                <td style="text-align:left;font-weight:600">@ritem.Name</td>
                                <td style="text-align:center;font-weight:600">@String.Format(new System.Globalization.CultureInfo("en-IN"), "{0:#,##}",ritem.CashBal)</td>
                            </tr>
                          }
                      }
                }
            <tr><td class="tblock" colspan="3">&nbsp;</td></tr>
        </table>
    </div>
</div>

