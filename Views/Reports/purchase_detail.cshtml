@model IEnumerable<Transport.Models.Invoice>

@{
    ViewBag.Title = "Dispatch Detail";
    Layout = null;
}

<link href="~/Content/bootstrap.css" rel="stylesheet" />
<link href="~/Content/report.css" rel="stylesheet" />
<div class="main-1">
    <div class="container">
        <table class="table-condensed" style="width:100%">
                <tr>
                    <td colspan='2' class="tblock" style="text-align:left;font-size:12px">Branch:- @ViewBag.Branch </td>
                    <th colspan='3' class="tblock"><b>Dispatch Detail</b></th>
                    <td colspan='2' class="tblock" style="text-align:right;font-size:12px">Print Date:- @DateTime.Now.Date.ToString("dd-MMM-yyyy")</td>
                </tr>
                <tr>
                    <td colspan='7' style="text-align:center;font-size:19px;font-weight:bold">@ViewBag.From_Party</td>
                </tr>
                <tr>
                    <td colspan='7' style="text-align:center;"><span style="border:1px solid #ccc;padding:5px;border-radius:2px">@ViewBag.From_Date  TO  @ViewBag.To_Date</span></td>
                </tr>
                @if (@ViewBag.To_Party != "ALL")
                {
                    <tr>
                        <td colspan='7' style="text-align:center;font-weight:600">@ViewBag.To_Party </td>
                    </tr>
                }
                <tr>
                    <th class="tblock">SNo </th>
                    <th class="tblock" style="width:100px">Date </th>
                    <th class="tblock">Inv No </th>
                    <th class="tblock">Recipient </th>
                    <th class="tblock">Truck No</th>
                    <th class="tblock">Royalty No</th>
                    <th class="tblock">Weight(M.T.)</th>
                </tr>
            @foreach (var gitem in Model.GroupBy(x => new { x.Supplier_Id, Supplier = x.Company2.Name }))
            {
                <tr>
                    <th  colspan="7" class="grpblock">@gitem.Key.Supplier</th>
                </tr>
                int I = 1;
                foreach (var pitem in Model.Where(x => x.Supplier_Id == gitem.Key.Supplier_Id).GroupBy(x => new { x.Product_Id, x.Product.Name }).Select(x => new { Product_Id = x.Key.Product_Id, Name = x.Key.Name, Weight = x.Sum(y => y.Weight) }).ToArray())
                {
                <tr>
                    <th colspan="3" style="text-align: center;">@pitem.Name</th>
                    <th colspan="4" style="background:none">&nbsp;</th>

                </tr>
                    foreach (var item in Model.Where(x => x.Supplier_Id == gitem.Key.Supplier_Id && x.Product_Id == pitem.Product_Id).ToArray())
                    {
                <tr>
                    <td>@(I++)</td>
                    <td style="width:80px">@item.Invoice_Date.ToString("dd-MMM-yyyy")</td>
                    <td style="width:40px;text-align:center">@item.Invoice_No</td>
                    <td >@item.Company.Name</td>
                    <td>@item.Truck_No</td>
                    <td>@item.Royalty_No</td>
                    <td>@item.Weight</td>
                </tr>
                    }
                <tr>
                    <th colspan='6' style="text-align: right" class="tblock">Total Weight (M.T.)</th>
                    <th>@pitem.Weight</th>
                </tr>
                }
                <tr>
                    <td colspan="7"></td>
                </tr>
            }
        </table>
    </div>
</div>
