@model IEnumerable<Transport.Models.Invoice>

@{
    ViewBag.Title = "Freight Paidover";
    Layout = null;
}
<link href="~/Content/bootstrap.css" rel="stylesheet" />
<link href="~/Content/report.css" rel="stylesheet" />
<div class="main-1">
    <div class="container">
        <table class="table" style="width: 800px; font-size: small;">
            <tr>
                <td colspan='7'>Print Date @DateTime.Now.Date.ToString("dd-MMM-yyyy")</td>
            </tr>
            <tr>
                <th colspan='7' style="text-align: center"><b>Freight Paidover</b></th>
            </tr>
            <tr>
                <th colspan='2'>From :</th>
                <td>@ViewBag.From_Date</td>
                <td colspan='4'>From Party :@ViewBag.From_Party</td>
            </tr>
            <tr>
                <th colspan='2'>To :</th>
                <td>@ViewBag.To_Date</td>
                <td colspan='4'>@ViewBag.To_Party</td>
            </tr>
            <tr>
                <th colspan='7'></th>
            </tr>
            @foreach (var gitem in Model.GroupBy(x => new { x.Transport_Id, Supplier = x.Company1.Name }))
            {
                <tr>
                    <th style="background-color: cornsilk;" colspan="7">@gitem.Key.Supplier</th>
                </tr>
                <tr>
                    <th>S.NO</th>
                    <th>Bilty No</th>
                    <th>Date</th>
                    <th>Due Amt </th>
                    <th>Paid Amt </th>
                    <th>Paid Date </th>
                    <th>Remark</th>
                </tr>
            
                int I = 1;
                foreach (var item in Model.Where(x => x.Transport_Id == gitem.Key.Transport_Id).ToArray())
                {
                <tr>
                    <td>@(I++)</td>
                    <td>@item.Billty_No</td>
                    <td>@item.Invoice_Date.ToString("dd-MMM-yyyy")</td>

                    <td style="text-align: right;">@item.Deposit_Amount</td>
                    <td style="text-align: right;">@item.Paid_Amount</td>
                    <td>@item.Paid_Date</td>
                    <td></td>
                </tr>
                }
            
                <tr>
                    <th colspan='3' style="text-align: right">Total :</th>
                    <th style="text-align: right;">@Model.Where(x => x.Transport_Id == gitem.Key.Transport_Id).Sum(x => x.Deposit_Amount)</th>
                    <th style="text-align: right;">@Model.Where(x => x.Transport_Id == gitem.Key.Transport_Id).Sum(x => x.Paid_Amount)</th>
                    <th></th>
                    <th></th>
                </tr>
                <tr>
                <td colspan='7'></td>
            </tr>
            }
        </table>
    </div>
</div>
