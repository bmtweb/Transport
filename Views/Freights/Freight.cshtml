@model Transport.Models.Freight

@{
    ViewBag.Title = "Freight";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="main-1">
    <div class="container">
        <ul class="breadcrumb">
            <li><a href="#">Master</a></li>
            <li><a href="#">Freight</a></li>
            <li><a href="#">Add/Edit</a></li>
        </ul>
        @using (Html.BeginForm())
        {
            @Html.ValidationSummary(true)
            <div class="form-horizontal">
                <fieldset>
                    <legend>Freight Details</legend>
                    <div class="row form-horizontal">
                        <div class="form-group">
                            <div class="col-xs-12">
                                <div class="col-xs-6">
                                    @Html.LabelFor(model => model.From_Place, new { @class = "control-label" })
                                </div>
                                <div class="col-xs-6">
                                    @Html.LabelFor(model => model.To_Place, new { @class = "control-label" })
                                </div>
                                <div class="col-xs-6">
                                    @Html.DropDownListFor(model => model.From_Place,(SelectList)ViewBag.Supplier,"--Select From City--", new { @class = "form-control" })
                                    @Html.ValidationMessageFor(model => model.From_Place)
                                </div>
                                <div class="col-xs-6">
                                    @Html.DropDownListFor(model => model.To_Place,(SelectList)ViewBag.Companies,"--Select From To--", new { @class = "form-control" })
                                    @Html.ValidationMessageFor(model => model.To_Place)
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="row form-horizontal">
                        <div class="form-group">
                            <div class="col-xs-12">
                                <div class="col-xs-12">
                                    @Html.LabelFor(model => model.Rate, new { @class = "control-label" })
                                </div>
                                <div class="col-xs-6">
                                    @Html.TextBoxFor(model => model.Rate, new { @class = "form-control" })
                                    @Html.ValidationMessageFor(model => model.Rate)
                                </div>
                            </div>
                        </div>
                    </div>

                </fieldset>
            </div>
            <div class="form-horizontal">
                <div class="btn-group">
                    <input type="submit" value="@(Model.Id == 0 ? "Save" : "Update")" class="btn btn-info"/>
                </div>
                <div class="btn-group">
                    @{
                        if (Model.Id > 0)
                        {
                        <a href="/freights/delete/@Model.Id" class="btn btn-success btn-small" onclick="return confirm('Are you sure to delete this record');" >Delete</a>
                        }
                        @Html.ActionLink("Back", "index",null, new { @class = "btn btn-warning btn-small" })

                    }

                </div>
                <br />
                <br />
                <br />
                <br />

            </div>
        }

    </div>
</div>



@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}
