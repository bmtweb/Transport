@model PagedList.IPagedList<Transport.Models.Freight>
@using PagedList.Mvc;
@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<script>
    $(document).ready(function () {

        if ($('#divmsg').html().trim().length > 1) {
            $('#divmsg').dialog();
        }
    })
</script>

<div class="warning" id="divmsg" title="Message">
    @TempData["message"]
</div>
<div class="main-1">
    <div class="container">
        <ul class="breadcrumb">
            <li><a href="#">Master</a></li>
            <li><a href="#">Freight Rate</a></li>
        </ul>
        <div class="btn-group">
            @Html.ActionLink("Add New Freight Rate", "Freight", new { id = 0 }, new { @class = "btn btn-info btn-small" })
        </div>

        <table class="table table-condensed" style="width:100%;margin:15px 10px 0px 5px;">
            <tr>
                <th class="tblock">
                    @Html.DisplayName("From Place")
                </th>
                <th class="tblock">
                    @Html.DisplayName("To Place")
                </th>
                <th class="tblock">
                    @Html.DisplayName("Rate")
                </th>
                <th class="tblock">Action</th>
            </tr>

            @foreach (var item in Model)
            {
                <tr>
                    <td>
                        @Html.DisplayFor(modelItem => item.From_Place)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.To_Place)
                    </td>
                    <td style="font-size:14px">
                        @Html.DisplayFor(modelItem => item.Rate)
                    </td>
                    <td style="text-align:center">
                      @*  @Html.ActionLink("Edit", "Freight", new { id = item.Id })*@
                         <a href="@Url.Action("Freight", "Freights", new { id = item.Id })" title="Click to Edit Freight Rate">
                         <img src="@Url.Content("~/Content/images/edit.png")"  alt="EDIT"/>
                         </a>   
                    </td>
                </tr>
            }
                    <tr><td style="background-color:#49607C" colspan="4"></td></tr>

        </table>
        <div>
            Page  @(Model.PageCount < Model.PageNumber ? 0 : Model.PageNumber) of @Model.PageCount
            @Html.PagedListPager(Model, page => Url.Action("Index", new { page }))
        </div>
        <br />
        <br />

    </div>

</div>
