@model Transport.Models.Product

@{
    ViewBag.Title = "Material Detail";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<script type="text/javascript">
    function Validate() {
        if ($("input[type='checkbox'][class='chk']:checked").length == 0) {
            alert('At least one branch should be seleced!');
            return false;
        }
        else { return true; }
    }
</script>
<div class="main-1">
    <div class="container">
        @using (Html.BeginForm())
        {
            @Html.ValidationSummary(true)
            <div class="form-horizontal">
                <fieldset>
                    <legend>Material Details</legend>
                    <div class="row form-horizontal">
                        <div class="form-group">
                            <div class="col-md-12">
                                @Html.LabelFor(model => model.Name, new { @class = "col-md-2 control-label" })
                                <div class="col-md-6">
                                    @Html.TextBoxFor(model => model.Name, new { @class = "form-control" })
                                    @Html.ValidationMessageFor(model => model.Name)
                                </div>
                            </div>
                        </div>
                        
                        <div class="form-group">
                            <div class="col-md-12">
                                @Html.LabelFor(model => model.HSNCode, new { @class = "col-md-2 control-label" })
                                <div class="col-md-6">
                                    @Html.TextBoxFor(model => model.HSNCode , new { @class = "form-control" })
                                    @Html.ValidationMessageFor(model => model.HSNCode)
                                </div>
                            </div>
                        </div>

                        <div class="form-group">
                            <div class="col-md-12">
                                @Html.LabelFor(model => model.Active, new { @class = "col-md-2 control-label" })
                                <div class="col-md-6">
                                    @Html.CheckBoxFor(model => model.Active)
                                    @Html.ValidationMessageFor(model => model.Active)
                                </div>
                            </div>
                        </div>
                    </div>

                </fieldset>
                <fieldset>
                    <legend>Branches</legend>
                    <table class="table">
                        @foreach (var item in (List<Transport.Models.Branch>)ViewBag.Branches)
                        {
                            <tr>
                                <td style="width: 25px; margin-left: 50px;">
                                    <input class="chk" type="checkbox" id= "chk_@item.Id" name= "chk_@item.Id" @(Model.Product_Branches.Where(x => x.Branch_Id == item.Id).Count() > 0 ? "checked" : "unchecked") }/>
                                </td>
                                <td>@item.Name</td>
                            </tr>
                        }
                    </table>
                </fieldset>
            </div>
            <div class="form-horizontal">
                <div class="btn-group">
                    <input onclick="return Validate();" type="submit" value="Save" class="btn btn-info">
                </div>
                <div class="btn-group">
                    @{
                        if (Model.Id > 0)
                        {
                        <a href="/materials/delete/@Model.Id" class="btn btn-success btn-small" onclick="return confirm('Are you sure to delete this record');" >Delete</a>
                        }
                        @Html.ActionLink("Back", "index", null, new { @class = "btn btn-warning btn-small" })
                            
                    }
                </div>
                <br />
                <br />
                <br />
                <br />
            </div>
        }

    </div>
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}
