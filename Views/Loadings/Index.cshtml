@model PagedList.IPagedList<Transport.Models.Loading>
@using PagedList.Mvc;
@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="main-1">
    <div class="container">
        <ul class="breadcrumb">
            <li><a href="#">Master</a></li>
            <li><a href="#">Loading</a></li>
        </ul>
        <div class="btn-group">
            @Html.ActionLink("Add New Loading Place", "Loading", new { id = 0 }, new { @class = "btn btn-info btn-small" })
        </div>
        <table class="table table-condensed" style="width:100%;margin:15px 10px 0px 5px;">
            <tr>
                <th class="tblock" style="width:10%;text-align:center">S No</th>
                <th class="tblock">
                    @Html.DisplayName("Loading Place ")
                </th>
                <th class="tblock" style="width:10%">Action</th>
            </tr>
           @{
            int I = 1;
            foreach (var item in Model)
            { 

                <tr>
                    <td style="text-align:center" >
                        @(I++)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.Name)
                    </td>
                    <td>
                        @Html.ActionLink("Edit", "Loading", new { id = item.Id })
                    </td>
                </tr>
            }
            }
                    <tr><td style="background-color:#49607C" colspan="3"></td></tr>

        </table>
        <div>
            Page  @(Model.PageCount < Model.PageNumber ? 0 : Model.PageNumber) of @Model.PageCount
            @Html.PagedListPager(Model, page => Url.Action("Index", new { page }))
        </div>
        <br />
        <br />
    </div>
</div>
