@model Transport.Models.User

@{
    ViewBag.Title = "user";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="main-1">
    <div class="container">
        <ul class="breadcrumb">
            <li><a href="#">Master</a></li>
            <li><a href="#">User</a></li>
            <li><a href="#">Add/Edit</a></li>
        </ul>
        @using (Html.BeginForm())
        {
            @Html.ValidationSummary(true)
            <div class="form-horizontal">
                <fieldset>
                    <legend>User Details</legend>
                    <div class="row form-horizontal">
                        <div class="form-group">
                            <div class="col-xs-12">
                                <div class="col-xs-6">
                                    @Html.LabelFor(model => model.Name, new { @class = "control-label" })
                                </div>
                                <div class="col-xs-6">
                                    @Html.LabelFor(model => model.Role_Id, new { @class = "control-label" })
                                </div>
                                <div class="col-xs-6">
                                    @Html.TextBoxFor(model => model.Name, new { @class = "form-control" })
                                    @Html.ValidationMessageFor(model => model.Name)
                                </div>
                                <div class="col-xs-6">
                                    @Html.DropDownListFor(x => x.Role_Id, (SelectList)ViewBag.Roles, new { @class = "form-control" })
                                    @Html.ValidationMessageFor(model => model.Role_Id)
                                </div>
                            </div>

                            <div class="col-xs-12">
                                <div class="col-xs-6">
                                    @Html.LabelFor(model => model.Address, new { @class = "control-label" })
                                </div>
                                <div class="col-xs-6">
                                    @Html.LabelFor(model => model.City, new { @class = "control-label" })
                                </div>
                                <div class="col-xs-6">
                                    @Html.TextBoxFor(model => model.Address, new { @class = "form-control" })
                                    @Html.ValidationMessageFor(model => model.Address)
                                </div>
                                <div class="col-xs-6">
                                    @Html.TextBoxFor(model => model.City, new { @class = "form-control" })
                                    @Html.ValidationMessageFor(model => model.City)
                                </div>
                            </div>

                            <div class="col-xs-12">
                                <div class="col-xs-6">
                                    @Html.LabelFor(model => model.State, new { @class = "control-label" })
                                </div>
                                <div class="col-xs-6">
                                    @Html.LabelFor(model => model.Zip, new { @class = "control-label" })
                                </div>
                                <div class="col-xs-6">
                                    @Html.TextBoxFor(model => model.State, new { @class = "form-control" })
                                    @Html.ValidationMessageFor(model => model.State)
                                </div>
                                <div class="col-xs-6">
                                    @Html.TextBoxFor(model => model.Zip, new { @class = "form-control" })
                                    @Html.ValidationMessageFor(model => model.Zip)
                                </div>
                            </div>

                            <div class="col-xs-12">
                                <div class="col-xs-6">
                                    @Html.LabelFor(model => model.Phone, new { @class = "control-label" })
                                </div>
                                <div class="col-xs-6">
                                    @Html.LabelFor(model => model.Email, new { @class = "control-label" })
                                </div>
                                <div class="col-xs-6">
                                    @Html.TextBoxFor(model => model.Phone, new { @class = "form-control" })
                                    @Html.ValidationMessageFor(model => model.Phone)
                                </div>
                                <div class="col-xs-6">
                                    @Html.TextBoxFor(model => model.Email, new { @class = "form-control" })
                                    @Html.ValidationMessageFor(model => model.Email)
                                </div>
                            </div>

                            <div class="col-xs-12">
                                <div class="col-xs-6">
                                    @Html.LabelFor(model => model.User_ID, new { @class = "control-label" })
                                </div>
                                <div class="col-xs-6">
                                    @Html.LabelFor(model => model.Password, new { @class = "control-label" })
                                </div>
                                <div class="col-xs-6">
                                    @Html.TextBoxFor(model => model.User_ID, new { @class = "form-control" })
                                    @Html.ValidationMessageFor(model => model.User_ID)
                                </div>
                                <div class="col-xs-6">
                                    @Html.PasswordFor(model => model.Password, new { @value = Model.Password, @class = "form-control" })
                                    @Html.ValidationMessageFor(model => model.Password)
                                </div>
                            </div>
                        </div>
                    </div>
                </fieldset>
                <fieldset>
                    <legend>Branches</legend>
                    <table class="table">
                        @foreach (var item in (List<Transport.Models.Branch>)ViewBag.Branches)
                        {
                            <tr>
                                <td style="width:25px; margin-left:50px;" ><input type="checkbox" id= "chk_@item.Id" name= "chk_@item.Id" @(Model.User_Branches.Where(x=> x.Branch_Id == item.Id).Count() > 0? "checked"  : "unchecked") }/> </td><td>@item.Name</td>
                            </tr>
                        }
                    </table>

                </fieldset>
            </div>
            <div class="form-horizontal">
                <div class="button">
                    <input type="submit" value="Save" class="btn btn-info btn-small"/>
                    <br />
                    <br />
                    <br />
                    <br />
                </div>
            </div>
        }

    </div>
</div>


@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}
