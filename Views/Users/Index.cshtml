@model PagedList.IPagedList<Transport.Models.User>
@using PagedList.Mvc;
@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="main-1">
    <div class="container">
        <ul class="breadcrumb">
                <li><a href="#">Master</a></li>
                <li><a href="#">User</a></li>
            </ul>
        <div class="btn-group">
             @Html.ActionLink("Create New", "User", new { id = 0 }, new { @class = "btn btn-info btn-small" })
        </div>
        <div class="row form-horizontal">
            <div class="form-group">
                <table class="table table-responsive">
                    <tr>
                        <th>
                            <div class="col-xs-12">
                                <div class="col-md-4">
                                    <div class="col-md-6">Name</div>
                                    <div class="col-md-6">Role</div>
                                </div>
                                <div class="col-md-3">
                                    <div class="col-md-12">Address</div>

                                </div>
                                <div class="col-md-5">
                                    <div class="col-xs-4">City</div>
                                    <div class="col-xs-3">State</div>
                                    <div class="col-xs-3">Zip</div>
                                    <div class="col-xs-1"></div>
                                </div>
                            </div>
                        </th>
                    </tr>

                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>
                                <div class="col-xs-12">
                                    <div class="col-md-4">
                                        <div class="col-md-6">@item.Name</div>
                                        <div class="col-md-6">@item.Role.Name</div>
                                    </div>
                                    <div class="col-md-3">
                                        <div class="col-md-12">@item.Address</div>

                                    </div>
                                    <div class="col-md-5">
                                        <div class="col-xs-4">@item.City</div>
                                        <div class="col-xs-3">@item.State</div>
                                        <div class="col-xs-3">@item.Zip</div>
                                        <div class="col-xs-1">@Html.ActionLink("Edit", "user", new { id = item.Id })</div>
                                    </div>
                                </div>
                        </tr>
                    }

                </table>
            </div>
        </div>
        <div>
                  Page  @(Model.PageCount < Model.PageNumber ? 0 : Model.PageNumber) of @Model.PageCount
                    @Html.PagedListPager(Model, page => Url.Action("Index",new { page}))
                </div>
        <br />
        <br />
    </div>
</div>
