                </fieldset>
                <fieldset>
                    <legend>Select Branches </legend>
                    <table class="table-condensed" >
                        <tr>
                        @foreach (var item in (List<Transport.Models.Branch>)ViewBag.Branches)
                        {
                                <td style="width: 25px; margin-left: 50px;padding:5px">
                                    <input class="chk" type="checkbox" id= "chk_@item.Id" name= "chk_@item.Id" @(Model.Company_Branches.Where(x => x.Branch_Id == item.Id).Count() > 0 ? "checked" : "unchecked") }/>
