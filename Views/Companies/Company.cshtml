@model Transport.Models.Company

@{
    ViewBag.Title = "Company";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<script type="text/javascript">
    function Validate() {
        if ($("input[type='checkbox'][class='chk']:checked").length == 0) {
            alert('At least one branch should be seleced!');
            return false;
        }
        else { return true; }
    }

    $(document).ready(function () {
        HideShow();
        $('#Type').change(function () {
            HideShow();
        });

        function HideShow() {
            if ($('#Type').val() == "2") {
                $('.Phone').hide();
                $('.BillType').show();
            } else {
                $('.BillType').hide();
                $('.Phone').show();
            }
        }

    });
</script>

